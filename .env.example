# Địa chỉ Vite chuyển tiếp /api và /socket.io tới lúc dev.
# Backend thật (Gateway) và mock_server.py đều ở http://127.0.0.1:8080 (dùng 127.0.0.1, không dùng localhost: trên Windows Node có thể hiểu localhost là IPv6 ::1)
VITE_PROXY_TARGET=http://127.0.0.1:8080
# MediaMTX WHEP, chỉ cấu hình địa chỉ máy chủ tin cậy. Khi bỏ trống: hostname của trang, cổng 8889.
# Trang HTTPS cần media HTTPS. BE MEDIA_WEB_ORIGINS phải chứa origin của Dashboard.
VITE_MEDIA_BASE_URL=http://127.0.0.1:8889
